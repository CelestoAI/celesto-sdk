{
  "name": "@celestoai/sdk",
  "version": "0.1.5",
  "description": "Celesto SDK \u2014 managed agents, Gatekeeper, and Computers clients for Node.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CelestoAI/sdk.git",
    "directory": "ts"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./gatekeeper": {
      "types": "./dist/gatekeeper/index.d.ts",
      "import": "./dist/gatekeeper/index.js",
      "require": "./dist/gatekeeper/index.cjs"
    },
    "./computers": {
      "types": "./dist/computers/index.d.ts",
      "import": "./dist/computers/index.js",
      "require": "./dist/computers/index.cjs"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js",
      "require": "./dist/agents/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
